            },
            {
              "name": "origem",
              "value": "Sistema CAPFI"
            }
          ]
        },
        "options": {}
      },
      "id": "criar-contato",
      "name": "Criar Contato no Néctar",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1120, 100],
      "notes": "Cria novo contato se não existir"
    },
    {
      "parameters": {
        "url": "https://app.nectarcrm.com.br/crm/api/1/oportunidades/",
