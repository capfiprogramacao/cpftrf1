            },
            {
              "name": "status",
              "value": "Em prospecção"
            },
            {
              "name": "origem",
              "value": "Sistema CAPFI"
            }
          ]
        },
        "options": {}
      },
      "id": "criar-oportunidade",
      "name": "Criar Oportunidade no Néctar",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1340, 200],
      "notes": "Cria oportunidade vinculada ao contato"
    },
    {
      "parameters": {
