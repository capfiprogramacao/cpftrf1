{
  "name": "CAPFI — Integração Néctar CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "capfi/novo-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-entrada",
      "name": "Webhook — Novo Lead TRF1",
      "type": "n8n-nodes-base.webhook",
      "position": [240, 300],
      "notes": "Recebe dados do FastAPI quando um processo 'Encontrado' é identificado"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "contains",
              "value2": "Encontrado"
            }
          ]
        }
      },
      "id": "filtro-encontrado",
      "name": "Filtrar — Apenas Encontrados",
      "type": "n8n-nodes-base.if",
      "position": [460, 300],
      "notes": "Só envia ao Néctar processos com status Encontrado"
    },
    {
      "parameters": {
        "url": "https://app.nectarcrm.com.br/crm/api/1/contatos/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "busca",
              "value": "={{ $json.cpf }}"
            },
            {
              "name": "exato",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "buscar-contato-nectar",
      "name": "Buscar Contato no Néctar",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 200],
      "notes": "Verifica se o contato já existe no Néctar CRM pelo CPF"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.total }}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "id": "checar-existe",
      "name": "Contato já existe?",
      "type": "n8n-nodes-base.if",
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "https://app.nectarcrm.com.br/crm/api/1/contatos/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "nome",
              "value": "={{ $('Webhook — Novo Lead TRF1').item.json.nome }}"
