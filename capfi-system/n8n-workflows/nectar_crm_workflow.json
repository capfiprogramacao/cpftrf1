            },
            {
              "name": "prioridade",
              "value": "Alta"
            }
          ]
        },
        "options": {}
      },
      "id": "criar-tarefa",
      "name": "Criar Tarefa de Acompanhamento",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1560, 200],
      "notes": "Cria tarefa para o time entrar em contato"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"sucesso\": true, \"mensagem\": \"Lead enviado ao Néctar CRM com sucesso\" }"
      },
      "id": "resposta-sucesso",
      "name": "Resposta — Sucesso",
