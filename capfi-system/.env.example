# ─── CAPFI System — Variáveis de Ambiente ─────────────────────────────────────
# Copie este arquivo para .env e preencha os valores antes de iniciar o sistema
# NUNCA compartilhe o arquivo .env — ele contém senhas e chaves de API

# ── Banco de dados ─────────────────────────────────────────────────────────────
DB_PASSWORD=SUA_SENHA_FORTE_AQUI

# ── Claude API (usado apenas para análises complexas) ─────────────────────────
CLAUDE_API_KEY=sk-ant-SUA_CHAVE_AQUI

# ── Néctar CRM (obtido em: Configurações > Integrações > API) ─────────────────
NECTAR_API_TOKEN=SEU_TOKEN_NECTAR_AQUI

# ── n8n (acesso ao painel de automações) ──────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=SUA_SENHA_N8N_AQUI

# ── Chave de segurança interna (gere uma aleatória) ───────────────────────────
SECRET_KEY=CHAVE_ALEATORIA_32_CARACTERES_AQUI

# ── IP do VPS Hostinger (preencher após contratar) ────────────────────────────
VPS_IP=SEU_IP_AQUI
